# Waitlist backend. Until one of these is set, the form shows an honest
# "not configured" error and no email is silently dropped.
# Any endpoint that accepts a JSON POST works (Zapier, Make, Formspree, your own API).
WAITLIST_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>" to the webhook.
WAITLIST_WEBHOOK_TOKEN=

# Analytics (leave blank until you have real IDs)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL, used for metadata
NEXT_PUBLIC_SITE_URL=
